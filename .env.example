# Safe variable names and placeholders only. Never use VITE_ variables for secrets.
# Cloudflare Workers reads these as server-side bindings/secrets, not from this file.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://YOUR_WORKER_HOST/api/instagram/callback
APP_BASE_URL=https://YOUR_WORKER_HOST
APP_SESSION_SECRET=generate-a-long-random-secret
TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-random-key
IG_API_VERSION=v26.0

# Cloudflare KV binding is defined in wrangler.toml; replace both namespace IDs.
# APP_KV_PRODUCTION_ID=your-production-kv-namespace-id
# APP_KV_PREVIEW_ID=your-preview-kv-namespace-id
