# Safe placeholders only. The current demo does not read these variables.
# Configure any future Meta credentials as Cloudflare server-side secrets,
# never as VITE_* values or committed .env files.
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_REDIRECT_URI=https://your-domain.example/auth/callback
APP_BASE_URL=https://your-domain.example
